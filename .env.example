APP_NAME=Aurora Speech
APP_VERSION=1.0.0

CACHE_DIR=/app/cache

ENGINE_NAME=kokoro-82m-v2
DEFAULT_VOICE=teacher_female_v1

# Waveform post-processing (tames the trailing hiss of the pt-BR voices).
AUDIO_LOWPASS_HZ=3500        # one-pole HF de-emphasis; 0 = off
AUDIO_FADE_IN_MS=10
AUDIO_FADE_OUT_MS=200        # raised-cosine fade-out; 0 = off
AUDIO_GATE_ENABLED=true      # trailing noise gate
AUDIO_GATE_FLOOR_DB=-30.0    # tail RMS below this is ramped to zero
