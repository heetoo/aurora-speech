APP_NAME=Aurora Speech
APP_VERSION=1.0.0

CACHE_DIR=/app/cache

ENGINE_NAME=kokoro-82m-v2
DEFAULT_VOICE=teacher_female_v1

# Waveform post-processing (tames the trailing hiss of the pt-BR voices).
# Set a value to 0 to disable that stage.
AUDIO_LOWPASS_HZ=6000
AUDIO_FADE_IN_MS=10
AUDIO_FADE_OUT_MS=120
